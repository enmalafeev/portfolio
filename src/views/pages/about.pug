extends ../main.layout.pug

block variables
  - var title = 'Обо мне'

block scripts
  script(src='about.bundle.js')
  script(src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAZwMCDPLdKUm9wCOhHiCyoOtsd2j3FiXU&callback=initMap")
block content
  include ../common/hero.pug

  .container
    section.about
      .about__left
        .about__left-title
          h2.about-title__header.big-title= title
        .about__left-content
          .user-desc
            .user-desc__image
              +image("avatar.jpg", "Малафеев Евгений", "user-desc__avatar")

            .user-desc__data
              .user-desc__title
                h2.block-subtitle кто я
              .user-desc__text.text-content
                p Приветствую вас! Меня зовут Евгений. Я frontend-разработчик из Санкт-Петербурга.Я занимаюсь разработкой современных сайтов и приложений. Мне нравится делать интересные и современные проекты.
      .about__right
        .about-triangle
          //- svg.triangle.triangle_fill_beige
        .about__right-title
          h2.block-subtitle.block-subtitle__center Чем я могу быть вам полезен
        .about__right-description.text-content
          p Больше всего меня привлекет Frontend разработка, но я также знаком и могу решать не сложные задачи на Backend. Но давайте по порядку.
        .about__right-content
          #skills-container

  section.map
    #google-map
    .map__data
        .contacts
          h2.contacts__title.block-subtitle Контакты
          address.contacts__data
            ul.contacts__list
              -
                var contacts = [
                  ['skype', 'evgeny_malafeev', 'skype:evgeny_malafeev'],
                  ['phone', '@Evgeny_Malafeev']
                ]
              each item in contacts
                li.contacts__item.contacts-row
                  .contacts-row.contacts__icon
                    a(href=`${item[2]}`).contacts__link
                      +icon(`${item[0]}`, 'contacts__icon-img')
                      .contacts-row.contacts__title #{item[1]}






